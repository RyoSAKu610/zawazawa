# 実発注する場合のみ設定。出金権限のないAPIキーを使うこと。
MEXC_API_KEY=
MEXC_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=

# スキャン対象(板系エッジ)
EDGEBOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
EDGEBOT_NOTIONAL_USDT=200

# リスク上限 (運用資金 $100-500 想定)
EDGEBOT_MAX_ORDER_USDT=50
EDGEBOT_MAX_TOTAL_USDT=300
EDGEBOT_MIN_EDGE_BPS=5
# EDGEBOT_KILL_SWITCH=1

# 実アカウントの手数料が判明したら上書き
# MEXC_SPOT_TAKER=0.0005
# GATE_SPOT_TAKER=0.002
